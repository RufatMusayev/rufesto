# Copy to .env (git-ignored) and fill in what you need. Everything is optional.

# Targets (these are the defaults)
CONSUMER_URL=https://rufat-server.com
RESTO_URL=https://resto.rufat-server.com

# @guest specs: a consumer account that HAS a password (set it in the Supabase
# dashboard; the consumer UI only offers email-code / OAuth sign-in in prod builds).
QA_GUEST_EMAIL=
QA_GUEST_PASSWORD=

# @staff specs: one dashboard account per role (each test skips if its pair is empty).
QA_MANAGER_EMAIL=
QA_MANAGER_PASSWORD=
QA_WAITER_EMAIL=
QA_WAITER_PASSWORD=
QA_KITCHEN_EMAIL=
QA_KITCHEN_PASSWORD=

# Optional. The guest spec reads the Supabase URL + public anon key from the
# consumer app's own network traffic; set these only to override that.
QA_SUPABASE_URL=
QA_SUPABASE_ANON_KEY=

# Set to 1 once the kitchen-lockdown dashboard build (kitchen role: /kds only) is deployed.
QA_KITCHEN_LOCKDOWN_DEPLOYED=0

# Retries per test (default 0, so flakiness stays visible).
QA_RETRIES=0
